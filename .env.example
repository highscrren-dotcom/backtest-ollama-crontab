# === форк highscrren-dotcom: полный список переменных (см. README-FORK.md) ===

# Telegram MTProto — опционально: без этих переменных используются дефолтные
# app-креды автора из апстрима (api_id 31861455). Свои — https://my.telegram.org
# CC_TELEGRAM_API_ID=
# CC_TELEGRAM_API_HASH=

# Ollama Cloud (https://ollama.com) — Bearer-токен подписки
CC_OLLAMA_TOKEN=

# Риск-гейт: llm (Ollama, дефолт) | rules (детерминированно, без LLM) | off
CC_RISK_GATE=llm

# Инфраструктура (для запуска в docker: host.docker.internal)
CC_REDIS_HOST=127.0.0.1
CC_REDIS_PORT=6379
CC_REDIS_USER=default
CC_REDIS_PASSWORD=mysecurepassword
CC_MONGO_CONNECTION_STRING=mongodb://localhost:27017/backtest-pro?wtimeoutMS=15000

# Символы live-контура (через запятую)
# CC_SYMBOL_LIST=BTCUSDT,SOLUSDT,TRXUSDT

# Telegram-каналы для скрейпа (через запятую); каналы должны писать сигналы
# в шаблоне семейства Crypto Yoda. Дефолт: crypto_yoda_channel
# CC_CHANNEL_LIST=crypto_yoda_channel,another_signals_channel
